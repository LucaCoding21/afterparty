#!/bin/sh
# Blocks a push that changes size guides unless every guide passes the file
# check (tables in the house format, drawings cropped tight with no specks).
# Turned on by `npm install` (see "prepare" in package.json).

zero=0000000000000000000000000000000000000000
pattern='^(public/products/size-guides/|public/products/measurements/|app/routes/products\.\$handle\.tsx|scripts/size-guide\.py)'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="origin/main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -Eq "$pattern"; then
    echo "Size guide files changed: running the size guide check..."
    if ! python3 scripts/size-guide.py check; then
      echo ""
      echo "Push blocked: fix the size guide problems above, then push again."
      exit 1
    fi
    echo "Size guides OK. Before launch, also run: npm run check:size-guides (with npm run dev running)."
    exit 0
  fi
done
exit 0
